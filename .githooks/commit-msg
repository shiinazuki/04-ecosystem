#!/usr/bin/env bash
# 校验提交信息是否符合 Conventional Commits：CHANGELOG 的分组与
# cargo-release 的版本推导都依赖它。
#
# 安装：just hooks        临时跳过：git commit --no-verify
set -euo pipefail

msg_file="$1"
# 标题行 = 去掉注释行与空行之后的第一行
subject=$(grep -v '^#' "$msg_file" | sed '/^[[:space:]]*$/d' | head -1)

# 这几类由 git 自己生成，或留给后续 rebase 用，不做校验
case "$subject" in
    "Merge "* | "Revert "* | fixup!* | squash!* | amend!*) exit 0 ;;
esac

# type 列表与 cliff.toml 的 commit_parsers 保持一致，两边改要一起改
types='build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test'
re="^($types)(\([a-zA-Z0-9_./ -]+\))?!?: .+"

if [[ "$subject" =~ $re ]]; then
    exit 0
fi

{
    echo "✗ 提交信息不符合 Conventional Commits："
    echo
    echo "    ${subject}"
    echo
    echo "  格式：<type>[(scope)][!]: <描述>"
    echo "  type：${types}"
    # 引号括住的 'EOF'：里面的反引号和 $ 按字面量处理，不做替换
    cat <<'EOF'
  结尾的 `!` 表示破坏性变更（会让 cargo-release 抬 major）

  例子：
    feat(cli): 支持 --json 输出
    fix: 下游管道提前关闭时不再 panic
    chore(deps): 升级 tokio 到 1.53
    refactor!: greet 改为返回 Result

  临时跳过：git commit --no-verify
EOF
} >&2
exit 1
